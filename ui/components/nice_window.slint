import { Palette } from "std-widgets.slint";
import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { ColourScheme, Globals } from "../globals.slint";

export component NiceWindow inherits Window {
    init => {
        nice_init();
    }
    background: Globals.window_background;
    icon: Globals.icon;
    title: nice_window_title;

    in property <string> nice_window_title;

    // Declared here (rather than directly in each top-level window) so the forwarding logic
    // below is shared. Each top-level window re-exposes this as its own `colour_scheme`
    // property via a two-way binding, since Slint only generates Rust accessors for properties
    // declared directly on the top-level component.
    in-out property<ColourScheme> nice_colour_scheme;
    changed nice_colour_scheme => {
        Globals.colour_scheme = self.nice_colour_scheme;
        Globals.apply-colour-scheme();
    }

    protected function nice_init() {
        Palette.color-scheme = ColorScheme.dark;
//        debug("NiceWindow.init:  UAppTheme.dark.font-size-base = " + (UAppTheme.dark.font-size-base / 1px));
        UAppTheme.dark.font-size-base = 17px; // Default 14
        UAppTheme.dark.font-size-medium = 19px; // Default 16
        UAppTheme.dark.font-size-big = 21px; // Default 18
        UAppTheme.dark.font-size-bigger = 23px; // Default 20
        UAppTheme.dark.radius-base = 20px;
        // A `changed` callback never fires on a property's very first (default) evaluation when
        // that default already equals the value being assigned to it. Since every window starts
        // with `nice_colour_scheme` defaulting to the first `ColourScheme` enum value (dust-red),
        // `changed nice_colour_scheme` above would silently never run for a window whose colour
        // scheme ends up being dust-red (either because that's genuinely the current scheme, or
        // because this runs before a dialog's colour scheme is forwarded from the main window).
        // Applying it explicitly here guarantees `UAppTheme.dark.*` is always set correctly,
        // and any later real change still re-applies it via the `changed` callback above.
        Globals.colour_scheme = self.nice_colour_scheme;
        Globals.apply-colour-scheme();
    }
}